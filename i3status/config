general {
    colors = true
    interval = 1
    output_format = "i3bar"

    color_good = "#00FF00"
    color_degraded = "#FFFF00"
    color_bad = "#FF0000"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "volume master"
order += "load"
order += "cpu_usage"
order += "cpu_temperature 0"
order += "memory"
order += "disk /"
order += "battery all"
order += "tztime local"

wireless _first_ {
    format_up = " %essid (%quality)"
    format_down = ""
}

ethernet _first_ {
    format_up = " %ip (%speed)"
    format_down = ""
}

volume master {
    format = " %volume"
    format_muted = " %volume"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

load {
    format = " %1min"
    max_threshold = 4.0
}

cpu_usage {
    format = " %usage"
    degraded_threshold = 60
    max_threshold = 90
}

cpu_temperature 0 {
    format = " %degrees°C"
    path = "/sys/class/thermal/thermal_zone0/temp"
    max_threshold = 60
}

memory {
    format = " %used"
}

disk "/" {
    format = " %avail"
}

battery all {
    format = "%status %percentage %remaining"
    format_down = "No battery"
    status_chr = ""
    status_bat = ""
    status_full = ""
    status_idle = ""
    low_threshold = 20
    threshold_type = "percentage"
    integer_battery_capacity = true
    last_full_capacity = true
}

tztime local {
    format = " %a %-d %b   %H:%M"
}
