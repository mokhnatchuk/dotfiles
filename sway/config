set $mod Mod4
set $term foot
set $menu j4-dmenu-desktop --no-generic --dmenu="wmenu -i -f 'System-ui Bold 12' -N '#000000' -n '#ffffff' -S '#ffffff' -s '#000000'"

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart_no_gaps

output eDP-1 position 0,0
output HDMI-A-2 position 1920,0

exec swayidle -w \
     timeout 600 'systemctl suspend'

input type:touchpad {
	dwt enabled
    tap enabled
    natural_scroll disabled
    middle_emulation enabled
}

input type:keyboard {
    xkb_layout "fo,ua"
	xkb_variant "nodeadkeys"
	xkb_options "grp:lctrl_lwin_toggle"
}

exec wlsunset -T 5500 -t 5499

bindcode $mod+33 exec swaymsg output HDMI-A-2 pos 0 0 && swaymsg output eDP-1 pos 0 0
bindcode $mod+Shift+33 exec swaymsg output eDP-1 pos 0 0 && swaymsg output HDMI-A-2 pos 1920 0
bindcode $mod+Mod1+33 exec swaymsg output HDMI-A-2 enable pos 0 0 && sleep 0.5 && swaymsg output eDP-1 disable
bindcode $mod+Ctrl+33 exec swaymsg output eDP-1 enable pos 0 0 && swaymsg output HDMI-A-2 disable

bindsym $mod+Ctrl+Right exec swaymsg move workspace to output HDMI-A-2
bindsym $mod+Ctrl+Left exec swaymsg move workspace to output eDP-1

bindsym Mod1+0+1 output eDP-1 scale 1.0
bindsym Mod1+0+2 output eDP-1 scale 1.25
bindsym Mod1+0+3 output eDP-1 scale 1.5
bindsym Mod1+0+4 output eDP-1 scale 1.75
bindsym Mod1+0+5 output eDP-1 scale 2.0

bindsym Mod1+Shift+1 exec swaymsg output HDMI-A-2 scale 1.0
bindsym Mod1+Shift+2 exec swaymsg output HDMI-A-2 scale 1.25
bindsym Mod1+Shift+3 exec swaymsg output HDMI-A-2 scale 1.5
bindsym Mod1+Shift+4 exec swaymsg output HDMI-A-2 scale 1.75
bindsym Mod1+Shift+5 exec swaymsg output HDMI-A-2 scale 2.0

#bindcode Mod1+28 exec audacious -t
#bindcode Mod1+41 exec audacious -f
#bindcode Mod1+27 exec audacious -r
#bindcode Mod1+39 exec audacious -s

bindcode Mod1+65 exec audacious -t
bindcode Mod1+57 exec audacious -f
bindcode Mod1+33 exec audacious -r
bindcode Mod1+39 exec audacious -s

bindsym Print exec grim "$HOME/Pictures/Screenshots/Screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
bindsym $mod+Print exec grim -g "$(slurp)" "$HOME/Pictures/Screenshots/Screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
bindsym $mod+Shift+Print exec sh -c 'grim -g "$(swaymsg -t get_tree | jq -j '"'"'.. | select(.type?) | select(.focused).rect | "\(.x),\(.y) \(.width)x\(.height)"'"'"')" ~/Pictures/Screenshots/Screenshot-$(date +%Y-%m-%d_%H-%M-%S).png'

bindsym $mod+Mod1+0 exec sudo tpfanctl fan auto
bindsym $mod+Mod1+1 exec sudo tpfanctl fan 1
bindsym $mod+Mod1+2 exec sudo tpfanctl fan 2
bindsym $mod+Mod1+3 exec sudo tpfanctl fan 3
bindsym $mod+Mod1+4 exec sudo tpfanctl fan 4
bindsym $mod+Mod1+5 exec sudo tpfanctl fan 5
bindsym $mod+Mod1+6 exec sudo tpfanctl fan 6
bindsym $mod+Mod1+7 exec sudo tpfanctl fan 7

bindsym $mod+Return exec $term
bindcode $mod+24 kill
bindcode $mod+40 exec $menu
floating_modifier $mod normal
bindcode $mod+Shift+27 reload

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindcode $mod+56 splith
bindcode $mod+55 splitv

bindcode $mod+39 layout stacking
bindcode $mod+25 layout tabbed
bindcode $mod+26 layout toggle split

bindcode $mod+41 fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+Shift+minus move scratchpad
bindcode $mod+38 scratchpad show

workspace 1 output eDP-1
workspace 2 output eDP-1
workspace 3 output eDP-1
workspace 4 output eDP-1
workspace 5 output eDP-1
workspace 6 output HDMI-A-2
workspace 7 output HDMI-A-2
workspace 8 output HDMI-A-2
workspace 9 output HDMI-A-2
workspace 10 output HDMI-A-2

mode "resize" {
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindcode $mod+27 mode "resize"

bindcode $mod+Shift+24 exec swaynag \
    -m 'Choose an action:' \
    -B ' Shutdown' 'systemctl poweroff' \
	-B ' Reboot' 'systemctl reboot' \
	-B ' Suspend' 'systemctl suspend' \
	-B ' Log Out' 'swaymsg exit' \
	-B ' Lock' 'swaylock -f -c 000000'

bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym --locked XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 10%+

bar {
    status_command i3status
    position top
    font pango:System-ui Bold 12
    separator_symbol "⋮"

    colors {
        background #000000
        statusline #ffffff
        separator #808080

        focused_workspace  #000000 #000000 #ffffff
        active_workspace   #ffffff #000000 #ffffff
        inactive_workspace #000000 #000000 #808080
        urgent_workspace   #ff0000 #000000 #ffffff
        binding_mode       #ffff00 #000000 #ffffff
    }
}

# include /etc/sway/config.d/*

exec systemctl --user import-environment XDG_CURRENT_DESKTOP WAYLAND_DISPLAY
exec dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP=sway WAYLAND_DISPLAY
